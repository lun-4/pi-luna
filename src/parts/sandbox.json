{
  "enabled": true,
  "unsandboxedAllow": [],
  "autoMode": {
    "enabled": true,
    "model": "deepseek/deepseek-v4-flash-0731",
    "maxTokens": 256,
    "timeoutMs": 20000,
    "fallback": "prompt",
    "maxTranscriptChars": 64000,
    "bypassAllowlist": false,
    "systemPromptFile": "classifier-prompt.md",
    "interpreterPrograms": [
      "node",
      "python",
      "python3",
      "bash",
      "sh",
      "zsh",
      "perl",
      "ruby",
      "php",
      "lua",
      "deno",
      "bun",
      "pwsh",
      "powershell",
      "awk"
    ]
  },
  "shell": { "readAccess": "host" },
  "network": {
    "allowNetwork": true,
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnixSockets": [],
    "allowedDomains": [],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": ["/home", "/Users", "/root"],
    "allowRead": [
      ".",
      "/tmp",
      "/dev/null",
      "~/.gitconfig",
      "~/.config/git",
      "~/.npm",
      "~/.cache",
      "~/.cargo",
      "~/.rustup",
      "~/go",
      "~/.local/share/pnpm",
      "~/.m2",
      "~/.gradle"
    ],
    "allowWrite": [
      ".",
      "/dev/null",
      "/tmp",
      "~/.npm",
      "~/.cache",
      "~/.cargo",
      "~/go",
      "~/.local/share/pnpm",
      "~/.m2",
      "~/.gradle"
    ],
    "denyWrite": [
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      ".pi/sandbox.json",
      "~/.pi/agent/sandbox.json",
      "~/.pi/agent/luna-sandbox.json"
    ]
  }
}
